# OPSENTINEL Environment Configuration

# PostgreSQL + pgvector
POSTGRES_USER=opsentinel
POSTGRES_PASSWORD=opsentinel
POSTGRES_DB=opsentinel
DATABASE_URL=postgresql+psycopg://opsentinel:opsentinel@localhost:5432/opsentinel
AUTO_FALLBACK_SQLITE=true

# Redis Cache & Incident Sessions
REDIS_URL=redis://localhost:6379/0
AUTO_FALLBACK_FAKEREDIS=true
QUERY_CACHE_TTL_SECONDS=900
SESSION_TTL_SECONDS=7200
RUNBOOK_CACHE_TTL_SECONDS=3600

# Embeddings & Optional External OpenAI-Compatible LLM
# Works out-of-the-box with built-in 384d DevOps semantic vectorizer + Evidence RCA Synthesizer!
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
